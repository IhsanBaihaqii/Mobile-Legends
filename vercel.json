{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/ai/:id",
      "destination": "/api/ai?id=:id"
    },
    {
      "source": "/api/ai",
      "destination": "/api/ai"
    },
    {
      "source": "/api/hero/:id",
      "destination": "/api/hero?id=:id"
    },
    {
      "source": "/api/hero",
      "destination": "/api/hero"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
